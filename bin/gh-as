#!/usr/bin/env bash
set -euo pipefail

# Run gh CLI authenticated as a specific identity.
#
# Usage:
#   gh-as <identity> [gh args...]
#
# Reads identity credentials from ~/.config/gh-as/config.json.
# Supports auth types: app (GitHub App), pat (personal access token),
# passthrough (uses the default gh auth login identity).
#
# Example:
#   gh-as tamakiii-claude pr review 2 --repo tamakiii/sandbox-bevy --approve
#   gh-as tamakiii-doppelganger pr create --title "..."
#   gh-as tamakiii issue list --repo tamakiii/meta

CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/gh-as/config.json"

if [[ $# -lt 1 ]]; then
  echo "Usage: gh-as <identity> [gh args...]" >&2
  echo "" >&2
  if [[ -f "$CONFIG" ]]; then
    echo "Available identities:" >&2
    jq -r '.apps | keys[]' "$CONFIG" | sed 's/^/  /' >&2
  fi
  exit 1
fi

IDENTITY="$1"
shift

if [[ ! -f "$CONFIG" ]]; then
  echo "gh-as: config not found: $CONFIG" >&2
  exit 1
fi

app_config=$(jq -e --arg name "$IDENTITY" '.apps[$name] // empty' "$CONFIG" 2>/dev/null) || {
  echo "gh-as: unknown identity: $IDENTITY" >&2
  echo "Available identities:" >&2
  jq -r '.apps | keys[]' "$CONFIG" | sed 's/^/  /' >&2
  exit 1
}

auth_type=$(echo "$app_config" | jq -r '.type // "app"')
backend=$(echo "$app_config" | jq -r '.backend')

die() {
  echo "gh-as: $IDENTITY: $*" >&2
  exit 1
}

# Print the secret stored under a reference in the identity's backend.
# Errexit does not reach into the command substitutions this is called
# from, so every failure has to be returned explicitly.
fetch_secret() {
  local ref="$1"
  case "$backend" in
    pass)
      pass show "$ref"
      ;;
    security)
      local raw
      raw=$(security find-generic-password -s "$ref" -w) || return 1
      # macOS keychain hex-encodes values containing newlines (e.g. PEM keys);
      # detect hex output and decode with xxd -r -p
      if [[ "$raw" =~ ^[0-9a-fA-F]+$ ]] && (( ${#raw} > 512 )) && (( ${#raw} % 2 == 0 )); then
        printf '%s' "$raw" | xxd -r -p
      else
        printf '%s' "$raw"
      fi
      ;;
    *)
      echo "gh-as: unsupported backend: $backend" >&2
      return 1
      ;;
  esac
}

# Set the variable named by $1 to the secret under the reference $2.
# Stops the script when the secret cannot be fetched or is empty: gh run
# with an empty GH_TOKEN falls back to the `gh auth login` token, which
# would run the call as another identity.
read_secret() {
  local var="$1" ref="$2" value
  value=$(fetch_secret "$ref") || die "cannot fetch $ref from $backend"
  [[ -n "$value" ]] || die "$ref from $backend is empty"
  printf -v "$var" '%s' "$value"
}

case "$auth_type" in
  passthrough)
    ;;
  pat)
    read_secret token "$(echo "$app_config" | jq -r '.token')"
    export GH_TOKEN="$token"
    ;;
  app)
    app_id_ref=$(echo "$app_config" | jq -r '."app-id"')
    read_secret app_id "$app_id_ref"
    read_secret installation_id "$(echo "$app_config" | jq -r '."installation-id"')"
    read_secret private_key "$(echo "$app_config" | jq -r '."private-key"')"
    token=$("${HOME}/.local/bin/gh-app-token" \
      "$app_id" \
      "$installation_id" \
      <(printf '%s\n' "$private_key")) \
      || die "gh-app-token failed for the app in $app_id_ref"
    [[ -n "$token" ]] || die "gh-app-token returned an empty token for the app in $app_id_ref"
    export GH_TOKEN="$token"
    ;;
  *)
    echo "gh-as: unsupported auth type: $auth_type" >&2
    exit 1
    ;;
esac

# Find the real gh binary, excluding wrappers
SELF_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
for p in $(type -ap gh); do
  real="$(readlink -f "$p")"
  # Skip the gh wrapper that lives alongside gh-as
  [[ "$(dirname "$real")" == "$SELF_DIR" ]] && continue
  # Skip other shell-script wrappers that chain back into gh-as
  # (e.g. ~/.myfiles/.claude/bin/gh → `exec gh-as tamakiii-claude "$@"`).
  # Without this, the PATH walk finds a wrapper before the real gh and
  # re-exec loops infinitely.
  if [[ -f "$real" ]] \
     && head -c 2 "$real" 2>/dev/null | grep -q '^#!' \
     && head -n 5 "$real" 2>/dev/null | grep -q 'gh-as'; then
    continue
  fi
  exec "$p" "$@"
done
echo "gh: not found" >&2
exit 1
